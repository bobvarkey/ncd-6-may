{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/main.tsx",
    "src/App.tsx",
    "index.html",
    "vite.config.ts",
    "tailwind.config.ts",
    "eslint.config.js"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": [
    "src/components/ui/**",
    "src/**/*.test.{ts,tsx}",
    "src/**/*.stories.{ts,tsx}"
  ],
  "ignoreDependencies": [
    "@testing-library/jest-dom",
    "@testing-library/react",
    "jsdom",
    "vitest",
    "tailwindcss-animate",
    "@tailwindcss/typography"
  ]
}
